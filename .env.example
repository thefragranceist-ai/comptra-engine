# Comptra API configuration

# --- local / node host ---
PORT=8787
COMPTRA_DATA=./data                 # append-only JSONL ledger + JSON control plane live here

# --- rail selection (default: simulated, needs no credentials) ---
# COMPTRA_RAIL=stripe-issuing-test
# STRIPE_SECRET_KEY=sk_test_...      # TEST MODE ONLY — Comptra never moves live funds itself
# Configure Stripe's authorization webhook timeout fallback to DECLINE (shared-responsibility boundary).

# --- checkpoint signing (Ed25519) ---
# Generated automatically into COMPTRA_DATA/signing-key.json on first boot.
# In production hold the private key OUTSIDE the ledger DB trust domain (KMS/HSM).
# For the Cloudflare worker entry, pass it as a secret:
# COMPTRA_SIGNING_KEY_PKCS8_HEX=...
# COMPTRA_ADMIN_KEY=cmp_test_...     # raw admin key the worker should accept (its hash is stored)

# --- deploy: Turso / libSQL (swap the LedgerStore behind the interface, no code change) ---
# TURSO_URL=libsql://your-db.turso.io
# TURSO_TOKEN=...
